# Vault configuration. Copy to .env and fill in.

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_SECRET_KEY=change-me-before-you-deploy

# "Sign in with Google" client ID. Email/password login works without this;
# the Google button only appears once it is set.
# Get one at https://console.cloud.google.com/apis/credentials
#   Create Credentials -> OAuth client ID -> Web application
#   Authorized JavaScript origins: http://localhost:5173 and http://localhost:8000
VAULT_GOOGLE_CLIENT_ID=

# Public base URL, used to build share links.
VAULT_PUBLIC_URL=http://localhost:5173

# Max upload size per track, in megabytes.
VAULT_MAX_UPLOAD_MB=200
